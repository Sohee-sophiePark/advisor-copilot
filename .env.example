# Advisor Copilot — copy to .env and fill in. Never commit .env.
# Load into your shell before live targets:  set -a; . ./.env; set +a
# Gemini API key (free tier): https://aistudio.google.com/apikey — needed only for live/record modes.
GEMINI_API_KEY=
# live | record | replay  (replay needs no key; overrides run_mode in config/settings.yaml)
RUN_MODE=replay
# fictional | official  (official = latest fetched prices; laptop only, never the public build)
DATA_SOURCE=fictional
# `make fetch` (laptop only, free sources, daily caps in config/settings.yaml)
# SEC EDGAR asks for a name and contact email; no sign-up or verification.
SEC_USER_AGENT=
# Tiingo free plan (no card): https://www.tiingo.com — personal use only, prices are never published.
TIINGO_API_KEY=
