.env
.env*
*.env
*.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
id_rsa*
id_ed25519*
*.kdbx
.netrc
.npmrc
.pypirc
secrets/
.aws/
.ssh/
**/credentials/**
*credentials*.json
*service-account*.json
*secret*.json
*.secret
*.secrets

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.uv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — never commit
.env
*.env.local

# Runtime output (replays/ is committed on purpose for the public demo)
outputs/
runs/
logs/
*.log

# Frontend
web/node_modules/
web/dist/

# OS / IDE
.DS_Store
.vscode/
.idea/

# Eval reports — only latest.md is committed
evals/reports/*
!evals/reports/latest.md

# Machine-specific preview config
.claude/launch.json

# Internal docs — public repo carries only README.md, the architecture diagram and the tech stack
INTERNAL.md
CLAUDE.md
docs/*
!docs/img/
!docs/ARCHITECTURE.md

# Local SQLite (rebuilt by make seed)
data/*.db
data/*.db-*

